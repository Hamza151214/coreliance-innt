# Kopiér denne fil til server/.env og indsæt din egen OpenAI-nøgle.
# server/.env er i .gitignore og må aldrig committes eller deles.
OPENAI_API_KEY=your-openai-api-key-here

# Valgfrit: hvilken OpenAI-model der bruges (standard: gpt-5-mini).
# OPENAI_MODEL=gpt-5-mini

# Valgfrit: port for den lokale AI-server (standard: 3001).
# PORT=3001

# Valgfrit: hvilken adresse serveren lytter på.
# Standard er 127.0.0.1 (kun denne computer). "npm run dev" sætter 0.0.0.0,
# så en telefon på samme Wi-Fi kan nå serveren.
# HOST=127.0.0.1
